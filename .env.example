# Japan Auction Arena Environment Variables Template
# Copy this file to .env and fill in the values from your Firebase Console:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app -> Config

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=japan-auction-arena.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=japan-auction-arena
VITE_FIREBASE_STORAGE_BUCKET=japan-auction-arena.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# SECURITY NOTE:
# 1. Do NOT put Firebase Admin SDK private keys, service account JSON files, or database secrets in this file.
# 2. Never commit your actual .env file to Git repository.
# 3. If these environment variables are absent, the application gracefully operates in Local Simulation Mode.
